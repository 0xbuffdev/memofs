{
	"name": "@memofs/spec",
	"version": "1.3.0-beta.2",
	"private": false,
	"description": "Versioned JSON Schemas and validation for portable MemoFS memory data.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xbuffdev/memofs.git",
		"directory": "packages/spec"
	},
	"homepage": "https://docs.memofs.dev/packages/spec/",
	"bugs": {
		"url": "https://github.com/0xbuffdev/memofs/issues"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./schema/v1/manifest.json": "./schema/v1/manifest.json"
	},
	"files": [
		"dist",
		"schema",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/",
		"provenance": true
	},
	"scripts": {
		"build": "pnpm build:schemas && tsdown",
		"build:schemas": "ts-json-schema-generator --path ../core/src/core/types/memory-documents.ts --type MemoFsManifest --tsconfig ../core/tsconfig.json --out schema/v1/manifest.json",
		"build:watch": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"clean": "rm -rf dist coverage .turbo",
		"lint:package": "publint",
		"prepack": "pnpm build",
		"pack:dry-run": "pnpm build && npm pack --dry-run",
		"release:check": "pnpm build && pnpm typecheck && pnpm test:run && pnpm lint:package && npm pack --dry-run"
	},
	"keywords": [
		"ai",
		"agents",
		"json-schema",
		"memory",
		"memofs",
		"validation"
	],
	"engines": {
		"node": ">=22"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/christophersesugh"
	},
	"devDependencies": {
		"@repo/tsdown": "workspace:*",
		"@repo/typescript": "workspace:*",
		"ts-json-schema-generator": "^2.9.0"
	},
	"dependencies": {
		"ajv": "^8.20.0"
	}
}
