{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "dev.memofs/mcp-server",
	"title": "MemoFS MCP Server",
	"description": "Persistent memory and virtual filesystem MCP server for AI agents.",
	"version": "1.3.0-beta.3",
	"websiteUrl": "https://memofs.dev",
	"repository": {
		"url": "https://github.com/0xbuffdev/memofs",
		"source": "github",
		"subfolder": "packages/mcp-server"
	},
	"packages": [
		{
			"registryType": "npm",
			"identifier": "@memofs/mcp-server",
			"version": "1.3.0-beta.3",
			"transport": {
				"type": "stdio"
			},
			"environmentVariables": [
				{
					"name": "MEMOFS_API_KEY",
					"description": "API key for MemoFS Cloud synchronization (required for hybrid mode)",
					"isSecret": true,
					"isRequired": false
				},
				{
					"name": "MEMOFS_RUNTIME",
					"description": "Runtime mode: local or hybrid",
					"choices": ["local", "hybrid"],
					"default": "local",
					"isRequired": false
				}
			]
		}
	],
	"remotes": [
		{
			"type": "streamable-http",
			"url": "https://memofs.dev/api/v1/projects/{projectId}/mcp",
			"variables": {
				"projectId": {
					"description": "MemoFS Cloud Project ID",
					"isRequired": true
				}
			},
			"headers": [
				{
					"name": "Authorization",
					"description": "Bearer token using your MemoFS Cloud API key",
					"isRequired": true,
					"isSecret": true
				}
			]
		}
	]
}
